<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import sehati.presentation.PanelPeringatan?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="sehati.presentation.LoginForm" styleClass="layar-masuk">
    <VBox fx:id="kartuMasuk" styleClass="kartu-masuk" spacing="8" maxWidth="400" maxHeight="-Infinity">
        <HBox fx:id="merekMasuk" spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="2">
                <Label text="SEHATI" styleClass="logo-masuk"/>
                <Label text="Sistem Elektronik Pelayanan Kesehatan Terintegrasi" styleClass="label-kolom" wrapText="true"/>
            </VBox>
        </HBox>
        <Label text="Masuk" styleClass="judul-masuk"/>
        <Label text="Gunakan akun yang diberikan Petugas Administrasi." styleClass="teks-bantu" wrapText="true"/>
        <Label text="Nama pengguna" styleClass="label-kolom"/>
        <TextField fx:id="kolomNamaPengguna" promptText="nama.pengguna"/>
        <Label text="Kata sandi" styleClass="label-kolom"/>
        <PasswordField fx:id="kolomKataSandi"/>
        <Label fx:id="labelPesanGagal" styleClass="pesan-kolom" wrapText="true"/>
        <Button fx:id="tombolMasuk" text="Masuk" styleClass="tombol-utama" maxWidth="Infinity"/>
    </VBox>
    <VBox fx:id="panelDasbor" styleClass="panel-dasbor" spacing="16">
        <VBox spacing="4">
            <Label fx:id="labelDasbor" styleClass="judul-dasbor"/>
            <Label fx:id="labelPeranDasbor" styleClass="teks-bantu"/>
        </VBox>
        <PanelPeringatan fx:id="panelPencadangan" visible="false"
                         pesan="Pencadangan terakhir gagal. Jalankan ulang dari layar Konfigurasi dan Basis Data."/>
        <Label fx:id="labelPencadangan" styleClass="teks-bantu" wrapText="true"/>
        <FlowPane fx:id="kartuMenu" hgap="12" vgap="12" rowValignment="TOP"/>
        <Label fx:id="labelAksesDitolak" styleClass="pesan-kolom" wrapText="true"/>
        <Label text="F1 daftar pintasan  ·  Ctrl+D dasbor  ·  Esc kembali" styleClass="teks-bantu"/>
    </VBox>
</StackPane>
