<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
      fx:controller="sehati.presentation.PasienForm" styleClass="halaman" style="-fx-padding: 24; -fx-spacing: 14;"
      fx:id="akar">

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Pendaftaran Pasien" styleClass="judul-panel"/>
            <Label text="Cari pasien yang sudah terdaftar, atau isi formulir di bawah untuk mendaftarkan pasien baru."
                   styleClass="label-kolom"/>
        </VBox>
        <Button fx:id="tombolPasienBaru" text="Pasien Baru (Ctrl+N)" styleClass="tombol-kedua"
                onAction="#bukaPasienBaru"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="kolomPencarian" promptText="Cari NIK, nama, atau nomor rekam medis (min. 3 karakter)"
               HBox.hgrow="ALWAYS"/>
    </HBox>

    <TableView fx:id="tabelHasil" prefHeight="200">
        <columns>
            <TableColumn fx:id="kolomNikTabel" prefWidth="160" text="NIK"/>
            <TableColumn fx:id="kolomRmTabel" prefWidth="150" text="No. Rekam Medis"/>
            <TableColumn fx:id="kolomNamaTabel" prefWidth="280" text="Nama"/>
            <TableColumn fx:id="kolomLahirTabel" prefWidth="140" text="Tanggal Lahir"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="Belum ada pasien terdaftar."
                   styleClass="label-kolom"/>
        </placeholder>
    </TableView>
    <Label fx:id="labelKosong"
           text="Data pasien tidak ditemukan. Isian di bawah boleh diisi untuk mendaftarkan pasien baru."
           wrapText="true" styleClass="label-kolom" visible="false" managed="false"/>

    <VBox styleClass="kartu" spacing="10">
        <Label text="Data Pasien" styleClass="judul-panel"/>
        <GridPane hgap="12" vgap="8">
            <columnConstraints>
                <ColumnConstraints prefWidth="150"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <Label text="NIK (16 digit)" styleClass="label-kolom" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomNik" promptText="9999010101010001" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label fx:id="pesanNik" styleClass="pesan-kolom" wrapText="true" GridPane.rowIndex="0"
                   GridPane.columnIndex="2" visible="false" managed="false"/>

            <Label text="Nomor rekam medis" styleClass="label-kolom" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomRm" editable="false" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

            <Label text="Nama" styleClass="label-kolom" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomNama" GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <Label text="Tanggal lahir" styleClass="label-kolom" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <DatePicker fx:id="kolomTanggalLahir" promptText="dd-mm-yyyy" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label text="Jenis kelamin" styleClass="label-kolom" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <ComboBox fx:id="kolomJenisKelamin" promptText="Pilih" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

            <Label text="Alamat" styleClass="label-kolom" GridPane.rowIndex="5" GridPane.columnIndex="0"
                   GridPane.valignment="CENTER"/>
            <TextArea fx:id="kolomAlamat" prefRowCount="2" wrapText="true" GridPane.rowIndex="5"
                      GridPane.columnIndex="1" GridPane.columnSpan="2"/>

            <Label text="Nomor telepon" styleClass="label-kolom" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomTelepon" promptText="Opsional; boleh kosong" GridPane.rowIndex="6"
                       GridPane.columnIndex="1" GridPane.columnSpan="2"/>
        </GridPane>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button fx:id="tombolBukaKunjungan" text="Buka Kunjungan" styleClass="tombol-kedua"
                    disable="true" onAction="#bukaKunjungan"/>
            <Button fx:id="tombolSimpan" text="Simpan (Ctrl+S)" styleClass="tombol-utama"
                    onAction="#kirimDataPasien"/>
        </HBox>
    </VBox>

    <Label fx:id="bilahNotifikasi" styleClass="notifikasi-hijau" wrapText="true"
           visible="false" managed="false"/>
</VBox>
