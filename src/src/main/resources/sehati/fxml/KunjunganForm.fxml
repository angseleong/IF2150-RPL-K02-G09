<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>


<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
      fx:controller="sehati.presentation.KunjunganForm" styleClass="halaman" style="-fx-padding: 24; -fx-spacing: 14;"
      fx:id="akar">

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Kunjungan Pasien" styleClass="judul-panel"/>
            <Label fx:id="labelPasien" text="Pilih poli tujuan untuk membuka kunjungan dan menerbitkan tiket antrean."
                   styleClass="label-kolom"/>
        </VBox>
        <Button fx:id="tombolKembali" text="Kembali (Esc)" styleClass="tombol-kedua" onAction="#kembaliKePasienForm"/>
    </HBox>

    <VBox styleClass="kartu" spacing="10">
        <Label text="Poli Tujuan" styleClass="judul-panel"/>
        <HBox spacing="10">
            <ComboBox fx:id="pilihanPoli" promptText="Pilih poli tujuan" HBox.hgrow="ALWAYS" minWidth="200"/>
            <Button fx:id="tombolBukaKunjungan" text="Buka Kunjungan" styleClass="tombol-utama"
                    disable="true" defaultButton="true" onAction="#kirimPermintaanKunjungan"/>
        </HBox>
    </VBox>

    <Label fx:id="bilahNotifikasi" styleClass="notifikasi-hijau" wrapText="true"
           visible="false" managed="false"/>

    <VBox fx:id="kartuTiket" styleClass="kartu" alignment="CENTER" spacing="8"
          visible="false" managed="false" style="-fx-padding: 32;">
        <Label fx:id="labelJudulTiket" text="Tiket Antrean" styleClass="judul-panel"/>
        <Label fx:id="labelNamaPoli" styleClass="label-kolom"/>
        <!-- Nomor besar agar mudah dibaca petugas skrining dari jarak jauh (KF03). -->
        <Label fx:id="labelNomorAntrean" style="-fx-font-size: 64px; -fx-font-weight: bold;"/>
        <Label fx:id="labelStatus" styleClass="label-kolom" visible="false" managed="false"/>
        <Label fx:id="labelTanggal" styleClass="label-kolom"/>
        <Label fx:id="labelKeterangan" styleClass="label-kolom" wrapText="true" textAlignment="CENTER"/>
        <Button fx:id="tombolCetak" text="Cetak Tiket" styleClass="tombol-kedua"
                visible="true" managed="true" onAction="#bukaDialogCetak"/>
    </VBox>
</VBox>
