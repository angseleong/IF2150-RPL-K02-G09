<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/21"
      fx:controller="sehati.presentation.KunjunganForm" styleClass="halaman"
      style="-fx-padding: 24; -fx-spacing: 14;">

    <HBox spacing="16" alignment="CENTER_LEFT">
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Kunjungan Pasien" styleClass="judul-panel"/>
            <Label text="Pilih poli tujuan untuk membuka kunjungan dan menerbitkan nomor antrean."
                   styleClass="label-kolom"/>
        </VBox>
        <Button text="Kembali (Esc)" styleClass="tombol-kedua" onAction="#kembali"/>
    </HBox>

    <VBox styleClass="kartu" spacing="6">
        <Label text="Pasien terpilih" styleClass="judul-panel"/>
        <Label fx:id="labelPasien" wrapText="true" styleClass="teks-tiket"/>
    </VBox>

    <VBox styleClass="kartu" spacing="10">
        <Label text="Poli tujuan" styleClass="judul-panel"/>
        <ComboBox fx:id="comboPoli" promptText="Pilih poli" maxWidth="360"/>
        <HBox alignment="CENTER_RIGHT">
            <Button fx:id="tombolBukaKunjungan" text="Buka Kunjungan" styleClass="tombol-utama"
                    disable="true" onAction="#kirimPermintaanKunjungan"/>
        </HBox>
    </VBox>

    <VBox fx:id="panelTiket" styleClass="tiket-antrean" visible="false" managed="false">
        <Label text="TIKET ANTREAN" styleClass="label-kolom"/>
        <Label fx:id="labelTiketPoli" styleClass="judul-panel"/>
        <Label fx:id="labelTiketNomor" styleClass="nomor-antrean"/>
        <Label fx:id="labelTiketTanggal" styleClass="teks-tiket"/>
        <Button fx:id="tombolCetakTiket" text="Cetak Tiket" styleClass="tombol-kedua"
                onAction="#cetakTiket"/>
    </VBox>

    <VBox fx:id="panelAktif" styleClass="panel-kuning" visible="false" managed="false">
        <Label text="Kunjungan sudah berjalan hari ini" styleClass="teks-peringatan"
               style="-fx-text-fill: -kuning;"/>
        <Label fx:id="labelAktif" wrapText="true" styleClass="teks-tiket"/>
        <Label text="Kunjungan baru tidak dibuat dan nomor antrean tidak diterbitkan ulang."
               wrapText="true" styleClass="label-kolom"/>
    </VBox>

    <Label fx:id="labelPesan" styleClass="pesan-kolom" wrapText="true" visible="false" managed="false"/>
</VBox>
