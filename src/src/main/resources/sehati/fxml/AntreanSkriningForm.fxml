<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="akar" fx:controller="sehati.presentation.AntreanSkriningForm" styleClass="halaman" spacing="12">
    <Label fx:id="labelRingkasan" styleClass="judul-panel" text="Menunggu skrining: 0 pasien"/>
    <TableView fx:id="tabelAntrean" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="kolomNomor" text="Antrean" prefWidth="90"/>
            <TableColumn fx:id="kolomPasien" text="Pasien" prefWidth="520"/>
            <TableColumn fx:id="kolomStatus" text="Status" prefWidth="180"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <Button fx:id="tombolPanggil" text="Panggil Berikutnya  (F2)" styleClass="tombol-utama"
                onAction="#kirimPanggilan"/>
        <Button fx:id="tombolLewati" text="Lewati: Tidak Hadir  (F3)" styleClass="tombol-kedua"
                onAction="#kirimLewati"/>
    </HBox>
    <Label fx:id="labelPembaruan" styleClass="label-kolom" text="Memuat antrean..."/>
</VBox>
