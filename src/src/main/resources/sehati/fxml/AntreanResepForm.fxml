<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.VBox?>
<?import sehati.presentation.PanelPeringatan?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="akar" fx:controller="sehati.presentation.AntreanResepForm" styleClass="halaman" spacing="12">
    <Label fx:id="labelJumlah" text="Resep menunggu: 0" styleClass="judul-panel"/>
    <TableView fx:id="tabelAntrean" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="kolomWaktu" text="Waktu masuk" prefWidth="110"/>
            <TableColumn fx:id="kolomPasien" text="Pasien" prefWidth="220"/>
            <TableColumn fx:id="kolomObat" text="Obat, dosis, dan jumlah" prefWidth="460"/>
            <TableColumn fx:id="kolomStatus" text="Status" prefWidth="120"/>
            <TableColumn fx:id="kolomAksi" text="" prefWidth="110" sortable="false"/>
        </columns>
    </TableView>
    <PanelPeringatan fx:id="panelPenolakan"/>
    <Label fx:id="bilahPesan" styleClass="notifikasi-hijau" wrapText="true"/>
    <Label fx:id="labelPenyegar" styleClass="label-kolom"/>
</VBox>
