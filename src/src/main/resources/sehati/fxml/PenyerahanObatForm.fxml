<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import sehati.presentation.PanelPeringatan?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="akar" fx:controller="sehati.presentation.PenyerahanObatForm" styleClass="halaman" spacing="12">
    <Label fx:id="labelPasien" styleClass="judul-panel"/>
    <VBox styleClass="kartu" spacing="8">
        <Label text="Item resep" styleClass="label-kolom"/>
        <TableView fx:id="tabelItem" prefHeight="150">
            <columns>
                <TableColumn fx:id="kolomItemObat" text="Obat" prefWidth="300"/>
                <TableColumn fx:id="kolomItemDosis" text="Dosis" prefWidth="140"/>
                <TableColumn fx:id="kolomItemJumlah" text="Jumlah" prefWidth="100"/>
                <TableColumn fx:id="kolomItemAturan" text="Aturan pakai" prefWidth="260"/>
            </columns>
        </TableView>
        <Label text="Bets yang diambil lebih dulu (kedaluwarsa terdekat)" styleClass="label-kolom"/>
        <TableView fx:id="tabelBets" prefHeight="150">
            <columns>
                <TableColumn fx:id="kolomBetsObat" text="Obat" prefWidth="300"/>
                <TableColumn fx:id="kolomBetsNomor" text="Nomor bets" prefWidth="160"/>
                <TableColumn fx:id="kolomBetsKedaluwarsa" text="Kedaluwarsa" prefWidth="140"/>
                <TableColumn fx:id="kolomBetsSisa" text="Sisa" prefWidth="100"/>
            </columns>
        </TableView>
    </VBox>
    <HBox spacing="10">
        <Button fx:id="tombolSerahkan" text="Obat Diserahkan  (Ctrl+Enter)" styleClass="tombol-utama"
                onAction="#serahkan"/>
        <Button fx:id="tombolKembalikan" text="Kembalikan ke Dokter" styleClass="tombol-kedua"
                onAction="#bukaPengembalian"/>
        <Button text="Kembali  (Esc)" styleClass="tombol-kedua" onAction="#kembali"/>
    </HBox>
    <VBox fx:id="panelPengembalian" styleClass="kartu" spacing="8">
        <Label text="Alasan pengembalian (wajib)" styleClass="label-kolom"/>
        <TextArea fx:id="kolomAlasan" prefRowCount="2" wrapText="true"
                  promptText="Contoh: Stok Kaptopril habis, mohon ganti obat"/>
        <Label fx:id="pesanAlasan" styleClass="pesan-kolom"/>
        <Button fx:id="tombolKirimPengembalian" text="Kirim Pengembalian" styleClass="tombol-kedua"
                onAction="#kirimAlasan"/>
    </VBox>
    <PanelPeringatan fx:id="panelPenolakan"/>
    <Label fx:id="bilahPesan" styleClass="notifikasi-hijau" wrapText="true"/>
</VBox>
