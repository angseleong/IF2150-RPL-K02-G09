<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import sehati.presentation.PanelPeringatan?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="akar" fx:controller="sehati.presentation.SinkronisasiForm"
      styleClass="halaman" spacing="12">

    <Label text="Sinkronisasi SATUSEHAT" styleClass="judul-panel"/>

    <VBox styleClass="kartu" spacing="8">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Status koneksi:" styleClass="label-kolom"/>
            <Label fx:id="labelKoneksi" text="Luring" styleClass="lampu-koneksi"/>
            <Label fx:id="labelTertunda" text="Tertunda: 0" styleClass="lencana-kuning"/>
        </HBox>

        <HBox spacing="8">
            <Button fx:id="tombolSinkron" text="Sinkronkan Sekarang" styleClass="tombol-utama"
                    onAction="#kirimPermintaanSinkron"/>
            <Button fx:id="tombolEkspor" text="Ekspor Bundel" styleClass="tombol-kedua"
                    onAction="#eksporBundel"/>
            <Button text="Kembali" styleClass="tombol-kedua" onAction="#kembali"/>
        </HBox>

        <ProgressBar fx:id="indikatorProses" maxWidth="Infinity"/>
    </VBox>

    <PanelPeringatan fx:id="panelPenolakan"/>

    <Label fx:id="bilahPesan" styleClass="notifikasi-hijau" wrapText="true"/>

    <VBox styleClass="kartu" spacing="8" VBox.vgrow="ALWAYS">
        <Label text="Status Bundel (tertunda dan 10 pengiriman terakhir)" styleClass="judul-panel"/>
        <TableView fx:id="tabelStatus" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="kolomId" text="ID" prefWidth="80"/>
                <TableColumn fx:id="kolomStatus" text="Status" prefWidth="140"/>
                <TableColumn fx:id="kolomAlasan" text="Alasan" prefWidth="360"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
