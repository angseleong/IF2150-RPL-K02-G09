<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import sehati.presentation.PanelPeringatan?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:id="akar" fx:controller="sehati.presentation.PersediaanForm" styleClass="halaman" spacing="12">
    <VBox styleClass="kartu" spacing="8">
        <Label text="Peringatan persediaan" styleClass="judul-panel"/>
        <ScrollPane fitToWidth="true" maxHeight="170" style="-fx-background-color: transparent;">
            <VBox fx:id="panelPeringatan" spacing="6"/>
        </ScrollPane>
    </VBox>
    <VBox styleClass="kartu" spacing="8">
        <Label text="Penerimaan obat masuk" styleClass="judul-panel"/>
        <GridPane hgap="12" vgap="8">
            <Label text="Obat" styleClass="label-kolom" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="kolomObat" prefWidth="320" promptText="Pilih obat"
                      GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <Label fx:id="pesanObat" styleClass="pesan-kolom" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
            <Label text="Nomor faktur" styleClass="label-kolom" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomFaktur" promptText="Contoh: FK-2026-1187" prefWidth="320"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"/>
            <Label fx:id="pesanFaktur" styleClass="pesan-kolom" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
            <Label text="Tanggal terima" styleClass="label-kolom" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <DatePicker fx:id="kolomTanggalTerima" promptText="dd-mm-yyyy"
                        GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            <Label fx:id="pesanTanggalTerima" styleClass="pesan-kolom" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
            <Label text="Nomor bets" styleClass="label-kolom" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomNomorBets" promptText="Contoh: B-2026-052" prefWidth="320"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            <Label fx:id="pesanNomorBets" styleClass="pesan-kolom" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
            <Label text="Jumlah" styleClass="label-kolom" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
            <TextField fx:id="kolomJumlah" promptText="Satuan sediaan" prefWidth="140"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"/>
            <Label fx:id="pesanJumlah" styleClass="pesan-kolom" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
            <Label text="Tanggal kedaluwarsa" styleClass="label-kolom" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
            <DatePicker fx:id="kolomKedaluwarsa" promptText="dd-mm-yyyy"
                        GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            <Label fx:id="pesanKedaluwarsa" styleClass="pesan-kolom" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
        </GridPane>
        <HBox spacing="10">
            <Button fx:id="tombolSimpan" text="Simpan  (Ctrl+S)" styleClass="tombol-utama" onAction="#simpan"/>
            <Button text="Kembali  (Esc)" styleClass="tombol-kedua" onAction="#kembali"/>
        </HBox>
    </VBox>
    <PanelPeringatan fx:id="panelPenolakan"/>
    <Label fx:id="bilahPesan" styleClass="notifikasi-hijau" wrapText="true"/>
    <VBox fx:id="panelSaldo" styleClass="kartu" spacing="6">
        <Label text="Saldo stok terbaru" styleClass="judul-panel"/>
        <Label fx:id="labelSaldo"/>
    </VBox>
</VBox>
