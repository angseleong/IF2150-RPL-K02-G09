# Salin menjadi .env lalu isi nilainya. Jangan commit .env.

# Basis data PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sehati
DB_USER=sehati_app
DB_PASSWORD=
# Kata sandi akun pemilik basis data, hanya dipakai docker-compose (#33).
DB_ADMIN_PASSWORD=

# REST API sandbox SATUSEHAT
SATUSEHAT_URL=
SATUSEHAT_TOKEN=
# Frasa sandi untuk mengenkripsi berkas ekspor bundel saat luring (Algo-C63-01)
EKSPOR_FRASA_SANDI=

# Pencadangan basis data (UC12)
# Folder di HDD eksternal tempat arsip pg_dump disimpan.
LOKASI_MEDIA_CADANGAN=
# Jam pencadangan harian 0-23. Isi hanya di komputer server, kosong = tidak terjadwal.
PENCADANGAN_JAM=
# Lokasi perintah bila tidak ada di PATH, misalnya /opt/homebrew/opt/libpq/bin/pg_dump.
PG_DUMP=pg_dump
PG_RESTORE=pg_restore
