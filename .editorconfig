root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,sql,fxml,css,xml}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Dua spasi di akhir baris Markdown berarti pemenggalan baris.
[*.md]
trim_trailing_whitespace = false
