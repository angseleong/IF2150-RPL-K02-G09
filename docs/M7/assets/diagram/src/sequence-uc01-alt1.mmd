sequenceDiagram
  autonumber
  actor A as Pengguna
  participant LoginForm as :LoginForm
  participant AutentikasiManager as :AutentikasiManager
  participant DataAkunBoundary as :DataAkunBoundary
  participant PenggunaEntity as :PenggunaEntity
  A->>+LoginForm: kirimKredensial()
  LoginForm->>+AutentikasiManager: autentikasi(nama, sandi)
  AutentikasiManager->>+DataAkunBoundary: cariPengguna(nama)
  DataAkunBoundary-->>-AutentikasiManager: pengguna
  AutentikasiManager->>PenggunaEntity: cocokkanSandi(sandi)
  PenggunaEntity-->>AutentikasiManager: false
  Note over AutentikasiManager: percobaanGagal bertambah satu
  AutentikasiManager->>DataAkunBoundary: simpanAudit(percobaan gagal)
  AutentikasiManager-->>-LoginForm: null
  LoginForm->>LoginForm: tampilkanPesanGagal("Nama pengguna atau kata sandi salah")
  LoginForm-->>-A: kolom kata sandi dikosongkan
  Note over A,LoginForm: pengguna mengisi ulang kredensial, kembali ke langkah 2 skenario normal
