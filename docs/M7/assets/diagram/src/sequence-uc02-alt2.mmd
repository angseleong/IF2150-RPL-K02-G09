sequenceDiagram
  autonumber
  actor A as Petugas Administrasi
  participant PasienForm as :PasienForm
  participant PasienManager as :PasienManager
  participant DataPasienBoundary as :DataPasienBoundary
  A->>+PasienForm: kirimDataPasien()
  PasienForm->>+PasienManager: daftarkanPasien(data)
  PasienManager->>PasienManager: validasiNIK(nik)
  alt NIK bukan 16 digit numerik
    PasienManager-->>PasienForm: galat "NIK tidak valid"
  else NIK sudah dimiliki pasien lain
    PasienManager->>+DataPasienBoundary: nikTerdaftar(nik)
    DataPasienBoundary-->>-PasienManager: true
    PasienManager-->>-PasienForm: galat "NIK sudah terdaftar"
  end
  PasienForm->>PasienForm: tampilkanPesanValidasi(pesan)
  PasienForm-->>-A: kolom NIK ditandai merah
  Note over A,PasienForm: petugas mengoreksi NIK, kembali ke langkah 4 skenario normal
