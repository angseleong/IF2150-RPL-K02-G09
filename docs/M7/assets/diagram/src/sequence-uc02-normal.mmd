sequenceDiagram
  autonumber
  actor A as Petugas Administrasi
  participant PasienForm as :PasienForm
  participant PasienManager as :PasienManager
  participant DataPasienBoundary as :DataPasienBoundary
  participant DataAkunBoundary as :DataAkunBoundary
  participant PasienEntity as :PasienEntity
  A->>PasienForm: tampilkan()
  A->>+PasienForm: kirimPencarian(kataKunci)
  PasienForm->>+PasienManager: cariPasien(kataKunci)
  PasienManager->>+DataPasienBoundary: cariParsial(kataKunci)
  DataPasienBoundary-->>-PasienManager: daftar kosong
  PasienManager-->>-PasienForm: daftar kosong
  PasienForm->>PasienForm: tampilkanHasilCari(daftar)
  PasienForm-->>-A: "Data pasien tidak ditemukan"
  A->>PasienForm: bukaFormulir(null)
  A->>+PasienForm: kirimDataPasien()
  PasienForm->>+PasienManager: daftarkanPasien(data)
  PasienManager->>PasienManager: validasiNIK(nik)
  PasienManager->>+DataPasienBoundary: nikTerdaftar(nik)
  DataPasienBoundary-->>-PasienManager: false
  PasienManager->>PasienManager: terbitkanNomorRM()
  PasienManager->>DataPasienBoundary: nomorRMBerikutnya()
  DataPasienBoundary-->>PasienManager: nomorRM
  PasienManager->>PasienEntity: «create»(data, nomorRM)
  PasienManager->>DataPasienBoundary: simpanPasien(pasien)
  Note over DataPasienBoundary: baris rekam medis pasien ikut dibuat dalam transaksi yang sama
  PasienManager->>DataAkunBoundary: simpanAudit(pendaftaran pasien)
  PasienManager-->>-PasienForm: pasien
  PasienForm->>PasienForm: tampilkanNotifikasi("Pendaftaran berhasil")
  PasienForm-->>-A: nomor rekam medis baru
