sequenceDiagram
  autonumber
  actor A as Pengguna
  participant LoginForm as :LoginForm
  participant AutentikasiManager as :AutentikasiManager
  Note over LoginForm: menu di luar wewenang sudah disembunyikan saat dasbor disusun
  A->>+LoginForm: bukaLayar("PemeriksaanForm")
  LoginForm->>+AutentikasiManager: periksaHakAkses("Perawat", "PemeriksaanForm")
  AutentikasiManager-->>-LoginForm: false
  LoginForm->>LoginForm: tampilkanPesanGagal("Peran Perawat tidak berwenang membuka layar ini")
  LoginForm-->>-A: akses ditolak
